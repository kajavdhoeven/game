{
  "cleanUrls": true,
  "rewrites": [
    { "source": "/g/:id", "destination": "/index.html" },
    { "source": "/c/:id", "destination": "/index.html" },
    { "source": "/(popular|new|categories|favorites|profile|admin|search/:q*)", "destination": "/index.html" }
  ],
  "headers": [
    { "source": "/vendor/(.*)", "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }] }
  ]
}
